# Configuracao do laboratorio. O Docker Compose le este arquivo sozinho.
# Todos os valores sao ficticios e servem apenas para este laboratorio.
#
# Se o Docker reclamar de "Pool overlaps with other one on this address space",
# a faixa 10.66.x.x ja esta em uso na sua maquina: troque o prefixo (por exemplo
# 10.66 por 10.88) em TODAS as linhas de IP abaixo e suba o laboratorio de novo.

# Redes (uma por zona): LAN interna da recepcao, DMZ dos servidores e rede EXTERNA dos hospedes
LAN_SUBNET=10.66.1.0/24
DMZ_SUBNET=10.66.2.0/24
EXT_SUBNET=10.66.3.0/24

# Enderecos do firewall (gateway de cada zona)
FW_LAN_IP=10.66.1.254
FW_DMZ_IP=10.66.2.254
FW_EXT_IP=10.66.3.254

# Enderecos dos demais containers
RECEPCAO_IP=10.66.1.10
HOSPEDE_IP=10.66.3.10
WEB_IP=10.66.2.10
DB_IP=10.66.2.11
PMS_IP=10.66.2.12

# Banco de dados do hotel (credenciais ficticias)
DB_NAME=hotel
DB_USER=hotel_app
DB_PASSWORD=senha_do_laboratorio